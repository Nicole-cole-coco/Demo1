# Select one provider: deepseek | openai | openai-compatible | local | mock
# Missing or incomplete credentials automatically fall back to MockProvider.
LLM_PROVIDER=

# DeepSeek (server-side only)
DEEPSEEK_API_KEY=
# Official OpenAI-compatible base URL: https://api.deepseek.com
DEEPSEEK_BASE_URL=
# Use the model id shown in the current DeepSeek model documentation.
DEEPSEEK_MODEL=

# OpenAI / OpenAI-compatible provider (server-side only)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Generic OpenAI-compatible or local provider
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Do not expose these values through NEXT_PUBLIC_* variables.
